{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kotilo Deck",
  "version": "1.0.0",
  "identifier": "dev.kotilo.deck",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "deck",
        "title": "Kotilo Deck",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; frame-src http://kotilo-widget.localhost kotilo-widget:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.kotilo/deck/wallpapers/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb", "rpm"],
    "publisher": "Kotilo",
    "homepage": "https://github.com/kotilo-dev/kotilo-deck",
    "copyright": "Copyright (c) 2026 Kotilo",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "Full-screen developer dashboard for a secondary display",
    "longDescription": "Kotilo Deck turns a secondary display, a small USB screen or an old tablet into a glanceable dashboard: clock, weather, calendar, system load, volume and media controls, pomodoro, todos and your AI agents, in every popular developer colour theme. Widgets snap to a cell grid, workspaces switch by hotkey or schedule, and everything stays on your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Kotilo",
        "compression": "lzma"
      },
      "wix": {
        "language": ["en-US", "tr-TR"]
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ],
        "recommends": ["pulseaudio-utils | wireplumber"],
        "section": "utils"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libappindicator-gtk3"],
        "recommends": ["pulseaudio-utils"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kotilo-dev/kotilo-deck/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwMTZFMTRDMUExNzUzMkQKUldRdFV4Y2FUT0VXb0xRRG1YMjIxU0U4OEUwSFgyaWRJRHd4bXl0aHhvQU9jZFIwYVZSMENrWXQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

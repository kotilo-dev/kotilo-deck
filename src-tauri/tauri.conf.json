{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kotilo Deck",
  "version": "0.0.1",
  "identifier": "dev.kotilo.deck",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "deck",
        "title": "Kotilo Deck",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; frame-src http://kotilo-widget.localhost kotilo-widget:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.kotilo/deck/wallpapers/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kotilo/kotilo-deck/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwMTZFMTRDMUExNzUzMkQKUldRdFV4Y2FUT0VXb0xRRG1YMjIxU0U4OEUwSFgyaWRJRHd4bXl0aHhvQU9jZFIwYVZSMENrWXQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
